{
  "schemaVersion": 1,
  "id": "cognitive-chart-proof",
  "purpose": "Verify cognitive visuals and a clearly synthetic chart",
  "emotion": "curious",
  "importance": "medium",
  "width": 960,
  "height": 540,
  "fps": 30,
  "duration": 4,
  "background": "role:background",
  "theme": { "id": "studio-proof", "version": "1" },
  "nodes": [
    {
      "id": "heading",
      "type": "label",
      "position": { "x": 480, "y": 35 },
      "width": 900,
      "height": 40,
      "start": 0,
      "duration": 4,
      "text": "Memory and comparison - synthetic demonstration",
      "fontSize": 20,
      "align": "center",
      "colorRole": "outline"
    },
    {
      "id": "hero",
      "type": "character",
      "characterId": "protagonist",
      "characterVersion": "1",
      "position": { "x": 140, "y": 350 },
      "width": 100,
      "height": 200,
      "start": 0,
      "duration": 4,
      "pose": "thinking",
      "expression": "thinking",
      "walkStepDuration": 0.2,
      "actions": [{ "type": "expressionSwap", "at": 3, "value": "happy" }]
    },
    {
      "id": "thought",
      "type": "thoughtBubble",
      "position": { "x": 155, "y": 140 },
      "width": 200,
      "height": 90,
      "start": 0,
      "duration": 4,
      "text": "Where did I put it?",
      "fontSize": 16
    },
    {
      "id": "context",
      "type": "contextBubble",
      "position": { "x": 180, "y": 465 },
      "width": 260,
      "height": 70,
      "start": 0,
      "duration": 4,
      "text": "Context: Room A",
      "fontSize": 16
    },
    {
      "id": "memory",
      "type": "memoryOrb",
      "position": "center",
      "width": 120,
      "height": 120,
      "start": 0,
      "duration": 4,
      "content": "PHONE",
      "fontSize": 16,
      "state": "active",
      "fadeDuration": 1,
      "stateChanges": [
        { "at": 0.5, "state": "weak" },
        { "at": 1, "state": "fading" },
        { "at": 2.5, "state": "hidden" },
        { "at": 3, "state": "retrieved" }
      ],
      "attachment": {
        "target": "hero",
        "anchor": "contextAnchor",
        "offset": { "x": 30, "y": -10 }
      }
    },
    {
      "id": "chart",
      "type": "barChart",
      "position": { "x": 700, "y": 290 },
      "width": 480,
      "height": 400,
      "start": 0,
      "duration": 4,
      "title": "Illustrative counts",
      "unit": "items",
      "yMax": 30,
      "decimals": 0,
      "bars": [
        { "id": "a", "label": "Group A", "value": 12, "highlight": false },
        { "id": "b", "label": "Group B", "value": 24, "highlight": true },
        { "id": "c", "label": "Group C", "value": 18, "highlight": false }
      ],
      "annotations": [{ "barId": "b", "text": "Focus" }],
      "dataSource": { "kind": "synthetic", "citation": "fixture values" },
      "reveal": { "start": 0.5, "duration": 1, "easing": "linear" }
    },
    {
      "id": "bar-marker",
      "type": "circle",
      "position": "center",
      "radius": 4,
      "fill": "role:primary",
      "start": 0,
      "duration": 4,
      "attachment": {
        "target": "chart",
        "anchor": "bar.b",
        "offset": { "x": 0, "y": -34 }
      }
    }
  ],
  "animations": [
    {
      "target": "hero",
      "start": 0,
      "duration": 1,
      "easing": "linear",
      "effect": { "type": "slideOut", "offset": { "x": 20, "y": 0 } }
    }
  ]
}
